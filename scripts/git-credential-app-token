#!/bin/sh
# git-credential-app-token: git credential helper that mints a fresh
# GitHub App installation token via mint-app-token.
#
# Configure per-repo (recommended) so only specific repos go through
# the App path:
#
#   git config credential.https://github.com.helper \
#     "~/.local/bin/git-credential-app-token <slug>"
#
# Git invokes credential helpers with the action (get|store|erase) as
# the final positional arg. We only handle 'get'; store/erase are no-
# ops because installation tokens are short-lived (~1h) and we mint a
# fresh one every time.

slug="$1"
action="$2"

if [ "$action" != "get" ]; then
    exit 0
fi

if [ -z "$slug" ]; then
    echo "git-credential-app-token: missing App slug" >&2
    exit 1
fi

token=$(mint-app-token "$slug" 2>/dev/null) || {
    echo "git-credential-app-token: mint-app-token $slug failed" >&2
    exit 1
}

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
