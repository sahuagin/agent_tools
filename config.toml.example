# agent_tools configuration — complete reference
#
# Install location: ~/.config/agent/config.toml   (chmod 600 — it holds keys)
#
# This file documents EVERY parameter the `agent` binary reads, in the
# /usr/local/etc spirit: features are discoverable here, not by hunting
# through source. Active values below are sane defaults or examples;
# commented values show the built-in default.
#
# Precedence for every setting: env var (per-invocation override)
# → this file → built-in default.

# ── Default store routing ────────────────────────────────────────────────────
# `agent memory` / `task` / `metrics` route to a central agent-mcp by DEFAULT
# when this is set, instead of the per-machine local DB (~/.local/share/
# agent.sqlite) — so the store stays in ONE shared place rather than drifting
# per host. Precedence: --via-mcp <url> flag → AGENT_MCP_URL env → this key →
# local DB (when unset). `dialogue` and `db-path` are never routed (dialogue has
# its own [dialogue] endpoint + streaming watch/poll; db-path is a local query).
#
# When the endpoint is set but UNREACHABLE: reads fall back to the local DB,
# writes fail loud (never a silent local write — that is the drift this avoids).
# Env override: AGENT_MCP_URL
[agent]
# mcp_url = "http://10.1.1.172:7700/mcp"

# ── API keys ─────────────────────────────────────────────────────────────────

[openrouter]
# Used for OpenRouter-hosted embeddings (and as the 401-stale-env-key
# fallback: if the env key gets HTTP 401, the value here is retried once).
# Env override: OPENROUTER_API_KEY
api_key = "sk-or-v1-REPLACE-ME"

# ── Embeddings ───────────────────────────────────────────────────────────────
# Backing store for `agent memory recall` / `reindex` / write-time
# nomination. Any OpenAI-compatible /v1/embeddings endpoint works; a
# non-OpenRouter base_url (e.g. local ollama) needs no API key.
#
# NOTE: memory_embeddings keys vectors by (memory_id, model). After
# changing `model`, run `agent memory reindex` — recall finds nothing
# under a model id it has no vectors for. Never mix vectors from
# different servings of "the same" model (quantization drift); reindex
# instead. Old rows remain as rollback.
#
# Env overrides: AGENT_EMBED_BASE_URL / AGENT_EMBED_MODEL / AGENT_EMBED_DIMS

[embed]
base_url = "http://localhost:11434/v1"
model = "qwen3-embedding:8b"
dims = 4096
# timeout_ms = 8000   # per-call HTTP read timeout; bounds the hang when the
#                     # endpoint (e.g. an occupied ollama box) accepts the
#                     # connection but never responds. Env: AGENT_EMBED_TIMEOUT_MS
# Built-in defaults when this section is absent:
# base_url = "https://openrouter.ai/api/v1"
# model = "baai/bge-large-en-v1.5"
# dims = 1024

# ── Embedding fallback (at-7mp) ──────────────────────────────────────────────
# OPTIONAL second embedder, tried only when [embed] above fails (timeout /
# connection refused / 5xx). Strictly opt-in: omit this section and behavior is
# unchanged. Use it to keep recall working when the primary (e.g. the local
# ollama box) is occupied or down.
#
# How it stays correct: memory_embeddings keys vectors by (memory_id, model),
# and recall filters by the model that produced the QUERY vector — so a
# fallback in a different vector space never cross-matches the primary's rows.
# For the fallback to return real semantic hits (not just empty), memories must
# ALSO be embedded under this model: `agent memory reindex` now embeds under
# EVERY configured embedder, and `agent memory add` dual-writes. If every
# embedder is down, recall degrades to FTS lexical search rather than hanging.
#
# Env overrides: AGENT_EMBED_FALLBACK_BASE_URL / _MODEL / _DIMS / _TIMEOUT_MS
# [embed.fallback]
# base_url = "https://openrouter.ai/api/v1"   # OpenRouter serves /embeddings
# model = "openai/text-embedding-3-small"      # 1536-dim; uses [openrouter].api_key
# dims = 1536
# timeout_ms = 15000

# ── Write-time supersession adjudication ─────────────────────────────────────
# On `agent memory add`, nominate the most-similar stored memories
# (embedding cosine ∪ FTS5; INCLUDING superseded rows, so re-learned
# stale facts meet their tombstones) and ask this model for a typed
# relation per candidate:
#
#   corrects  — the candidate was NEVER true; the new memory corrects it
#   updates   — the candidate WAS true; the world changed
#   duplicate — same assertion, no new information
#   refines   — adds detail without contradicting
#   unrelated — none of the above
#
# confidence >= auto_threshold        → supersession edge, automatically
#               (typed, audited, actor='adjudicator', reversible)
# queue_threshold <= conf < auto      → conflict_suspected queue row
#               (list: `agent memory conflicts`; resolve: correct/retract)
# candidate already superseded        → loud zombie warning + queue row
#
# FAIL-OPEN: endpoint down, model missing, malformed output — the add
# always succeeds; adjudication degrades to a logged warning.
#
# Section absent (or no model) = adjudication OFF.
# Per-call opt-out: `--no-adjudicate` or AGENT_NO_ADJUDICATE=1.
# Env overrides: AGENT_ADJUDICATE_BASE_URL / AGENT_ADJUDICATE_MODEL
#
# Any OpenAI-compatible /v1/chat/completions endpoint works; a local
# ollama coding/instruct model is plenty (verdicts are short JSON).

[adjudicate]
base_url = "http://localhost:11434/v1"
model = "qwen3-coder-next-agent262k:latest"
# auto_threshold = 0.8    # >= this confidence: create the edge
# queue_threshold = 0.5   # >= this: park in the queue

# ── Inter-agent dialogue ─────────────────────────────────────────────────────
# `agent dialogue` (watch/poll/say/peers) talks to a mu-dialogue MCP server.
# Resolution: --url flag → AGENT_DIALOGUE_URL env → this file → built-in default
# (http://localhost:7740/mcp). Set your deployed server here so the address is
# not baked into the binary; every caller (cc hooks, mu, your shell) reads it.
# Env override: AGENT_DIALOGUE_URL
[dialogue]
url = "http://localhost:7740/mcp"

# ── code-index MCP server (--listen) ─────────────────────────────────────────
# When code-index-mcp runs as an HTTP server (`--listen host:port`), the Host
# header is validated. localhost/127.0.0.1/::1 and the bind address are always
# allowed; list any EXTRA hostnames/IPs it is reached at (comma-separated) — the
# bare host and host:port forms are both allowed automatically.
# Env override: CODE_INDEX_ALLOWED_HOSTS
[code_index]
# allowed_hosts = "10.0.0.5"
#
# Where the index family lives. One host location holds every index as
# <name>.db; the MCP service serves out of it and the reindex cron maintains
# it. Default: ~/.cache/code_index
# cache_dir = "~/.cache/code_index"

# The repositories/locations that get indexed. THIS LIST IS THE SINGLE SOURCE
# OF TRUTH — it drives all three of:
#   1. `reindex-if-changed` with no arguments (so cron needs ONE line:
#        */15 * * * * ~/.local/bin/reindex-if-changed >/dev/null 2>&1
#      adding a repo is a config edit, never a crontab edit)
#   2. the `db` names `code_recall`/`code_status` accept over MCP
#   3. `code-index sources`, which is how an agent discovers those names
#      instead of guessing them
#
#   path : root directory to index (required). A STRING, or a LIST of
#          candidate paths — the first one that exists on the machine running
#          the ingest wins. Use a list when the same repo sits at different
#          paths from different vantages: a host path like /jails/<j>/... is
#          invisible from inside that jail, and the jail's own path is not the
#          host's. With a single absolute path, every machine that cannot see
#          it silently skips the source.
#   repo : true (default) — change detection via VCS head (jj, then git).
#          false — the location need not be a repository; its file tree is
#          hashed instead.
#   name : optional key override. Defaults to the path's trailing component,
#          which is a per-machine accident (the same repo checked out under
#          two names indexes twice) — set it explicitly when that matters.
#
# An index already sitting in cache_dir but NOT listed here still resolves, so
# nothing that works today stops working; it is simply unmaintained, and
# `code-index sources` reports it separately.
#
# [[code_index.sources]]
# path = "~/src/public_github/mu"
#
# [[code_index.sources]]
# path = "~/src/public_github/agent_tools"
#
# Same repo, two vantages — indexed from whichever machine runs the cron:
# [[code_index.sources]]
# path = ["~/src/public_github/agent_tools", "/jails/aiteam/home/you/src/public_github/agent_tools"]
#
# [[code_index.sources]]
# path = "~/notes"
# repo = false
# name = "notebook"

# ── kx knowledge index (`agent kx`) ──────────────────────────────────────────
# A kx entry is a POINTER (+ one-line summary + metadata + embedding) to one
# document in a configured corpus; the documents themselves stay as files on
# disk. `agent kx ingest` scans the [[kx.sources]] below and stores one row per
# document (type='kx') — reusing the same embedding + FTS machinery as
# `agent memory`, but kept OUT of personal-memory recall/context. Query it with
# `agent kx recall` (semantic), `agent kx search` (FTS lexical), `agent kx list`
# (browse). Retrieval is OPEN by default; --scope/--tag/--from/--to NARROW it.
#
# This section is host-local: ingest scans the paths on whatever host runs it.
# API keys live in OTHER sections above and are NEVER read or logged by kx.
[kx]
# Global knobs (all optional). Commented values show the built-in default.
#
# default_scope: ownership scope for entries whose source sets none. The scope
#   axis is work / personal / shared (a concrete profile sees its own + shared).
# default_scope = "work"
#
# summarize / summarize_model: PR #2 (model-summarized ingest). Parsed now but
#   NOT implemented — `kx ingest` errors loudly if summarize = true.
# summarize = false
# summarize_model = "qwen3-coder-next-agent262k:latest"
#
# embed_model: defaults to [embed].model; PR #1 embeds via the shared chain.
# embed_model = "qwen3-embedding:8b"
#
# min_score: cosine floor for `kx recall` (override per-call with --min-score).
# min_score = 0.60
#
# max_hits: operational hit cap for recall/search (override with --k / --limit).
# max_hits = 4
#
# max_depth: how deep the ingest walk descends below each source root (files in
#   the root are depth 0). The walk skips symlinks (so it can't loop or follow a
#   link off-tree); this caps REAL deep trees, nested mount points, and network
#   shares so a pathological corpus stays slow-but-finite. A capped dir is logged.
# max_depth = 64
#
# default_extensions: file types ingested when a source does not override them.
# default_extensions = ["md"]
#
# default_exclude: globs dropped from EVERY source (unioned with a source's own
#   exclude-globs). Real glob matching: `*` = any run of non-/, `**` = any run
#   of path segments, a slash-less pattern matches the basename anywhere.
# default_exclude = [
#     "**/.git/**", "**/.jj/**", "**/target/**", "**/node_modules/**",
#     "**/.venv/**", "**/__pycache__/**",
#     "*.log", "*.jsonl", "*.prompt.txt", "*.lock",
# ]

# A corpus to index. Repeat the [[kx.sources]] table for each one.
#   path         : root directory scanned recursively (there is no separate
#                  source "name" — `--source` matches this path, exact or by its
#                  trailing component).
#   extensions   : include only these; omit to use default_extensions.
#   exclude-globs: extra excludes, unioned with default_exclude.
#   scope        : ownership scope for this corpus (falls back to default_scope).
#   tags         : applied to every entry; combine with the auto tags
#                  repo:<leaf dir> and cat:<category>. Use topic:/cat:/repo:
#                  prefixes so --tag filters compose (ANDed, comma-anchored).
#   category     : adds a cat:<category> tag.
[[kx.sources]]
path = "~/notes"
extensions = ["md"]
exclude-globs = ["**/drafts/**"]
scope = "work"
tags = ["topic:notes"]
category = "reference"

# ── Logging (env, not config) ────────────────────────────────────────────────
# Status/diagnostics go through env_logger on stderr:
#   RUST_LOG=warn   silence confirmations
#   RUST_LOG=debug  verbose (compiled out of release builds above info)
# Command RESULTS (listings, --json) are stdout and unaffected.
