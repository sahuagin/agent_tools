#!/bin/sh
# Cron-friendly: re-index only if the source changed since the last run.
# Stores the last-indexed hash in the cache dir alongside the db.
#
# Two modes:
#   reindex-if-changed             every [[code_index.sources]] in the config
#   reindex-if-changed <path>      just that path (manual / legacy crontab line)
#
# The no-arg mode is the one for cron — ONE line covers every configured
# source, so adding a repo is a config edit, not a crontab edit:
#
#   */15 * * * * $HOME/.local/bin/reindex-if-changed >/dev/null 2>&1
#
# The source list comes from `code-index sources --porcelain`, NOT from a
# second TOML parser here: the cron and the MCP service must never disagree
# about what is indexed (at-o3t).
#
# 2026-06-05 fixes (the index had been silently stale since May 25):
#  - cron's PATH lacks ~/.local/bin and ~/.cargo/bin, so bare `code-index`
#    and `tq` were "not found" under cron — absolute paths now.
#  - `ingest | logger` reported logger's exit status, so a failed ingest
#    still wrote the hash and logged "done". The hash is now written only
#    when ingest actually succeeds; failures log loudly and exit 1.

set -e

CODE_INDEX="$HOME/.local/bin/code-index"
TQ="$HOME/.cargo/bin/tq"

OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-$("$TQ" -f "$HOME/.config/agent/config.toml" -r openrouter.api_key 2>/dev/null || true)}"
export OPENROUTER_API_KEY

# Change detector for a source root.
#   repo    -> VCS head (jj, then git)
#   content -> hash of the file tree, for locations that are not repositories
current_hash() {
    _root="$1"
    _kind="$2"
    if [ "$_kind" = "content" ]; then
        find "$_root" -type f ! -path '*/.git/*' ! -path '*/.jj/*' -print0 2>/dev/null |
            sort -z |
            xargs -0 ls -ln 2>/dev/null |
            awk '{print $5, $9}' |
            sha256sum 2>/dev/null | cut -d' ' -f1
        return 0
    fi
    (
        cd "$_root" 2>/dev/null || exit 0
        # `--verify --quiet` is load-bearing: plain `git rev-parse main` ECHOES
        # the literal string "main" on stdout when it cannot resolve it, exiting
        # non-zero. `2>/dev/null` hides the error but not the echo, so the
        # caller silently accepted "main" as a commit id — the source indexed
        # once, stored "main" as its marker, and then never reindexed again
        # because "main" always equals "main". A frozen index that looks
        # perfectly healthy.
        jj log -r main --no-graph -T 'commit_id' --limit 1 2>/dev/null ||
            git rev-parse --verify --quiet main 2>/dev/null ||
            true
    )
}

# Index one source. Args: name, root, kind (repo|content), db path ("" = default).
reindex_one() {
    NAME="$1"
    ROOT="$2"
    KIND="$3"
    DB="$4"

    if [ ! -d "$ROOT" ]; then
        logger -t code-index "skip ${NAME}: ${ROOT} not present on this host"
        return 0
    fi

    HASH_FILE="$HOME/.cache/code_index/.${NAME}.last-hash"

    # A per-repo .code_index/ still wins over the global cache. Track the
    # resolved path too, not just the flag — the skip decision below needs to
    # know whether the output still exists.
    if [ -d "$ROOT/.code_index" ]; then
        DB_PATH="$ROOT/.code_index/index.db"
        DB_FLAG=""
    elif [ -n "$DB" ]; then
        DB_PATH="$DB"
        DB_FLAG="--db $DB"
    else
        DB_PATH="$HOME/.cache/code_index/${NAME}.db"
        DB_FLAG="--db $DB_PATH"
    fi

    CURRENT="$(current_hash "$ROOT" "$KIND")"
    if [ -z "$CURRENT" ]; then
        # Used to `return 0` in silence, which is indistinguishable from "up to
        # date" — a source could sit unindexed forever with nothing in the
        # journal to say why. The usual cause is a jj checkout with no LOCAL
        # `main` bookmark (only `main@origin`), where both detectors come back
        # empty.
        logger -t code-index \
            "skip ${NAME}: no VCS head at ${ROOT} — no local 'main' bookmark/branch? (jj: 'jj bookmark create main -r main@origin'; or set repo = false for a non-repo location)"
        return 0
    fi

    LAST="$(cat "$HASH_FILE" 2>/dev/null || true)"

    # The hash means "nothing changed since the last ingest" — which is only
    # a reason to skip if that ingest's OUTPUT is still there. Deleting a db
    # is the documented recovery path (the cache is rebuildable by
    # definition), and trusting the hash alone made that silently do nothing
    # until the repo happened to change: the db stayed missing and every
    # recall against it failed. Require both.
    if [ "$CURRENT" = "$LAST" ] && [ -s "$DB_PATH" ]; then
        return 0
    fi
    if [ ! -s "$DB_PATH" ] && [ -n "$LAST" ]; then
        logger -t code-index "rebuilding ${NAME}: ${DB_PATH} is missing or empty despite an up-to-date hash"
    fi

    # A -wal/-shm with no db is orphaned by definition: a WAL is meaningless
    # without the database it journals, and leaving one beside a fresh db of
    # the same name invites sqlite to recover state that is not its own.
    # Scoped deliberately to the db-absent case — never touch sidecars that
    # still have their database, which may belong to a live writer.
    if [ ! -f "$DB_PATH" ]; then
        for _sidecar in "${DB_PATH}-wal" "${DB_PATH}-shm"; do
            if [ -e "$_sidecar" ]; then
                logger -t code-index "removing orphaned $(basename "$_sidecar") (no ${NAME} db)"
                rm -f "$_sidecar"
            fi
        done
    fi

    LOGTMP="$(mktemp -t code-index-ingest)"

    logger -t code-index "reindexing ${NAME} (${LAST:-none} -> ${CURRENT})"
    if ( cd "$ROOT" && "$CODE_INDEX" ingest . $DB_FLAG ) >"$LOGTMP" 2>&1; then
        logger -t code-index <"$LOGTMP"
        echo "$CURRENT" >"$HASH_FILE"
        logger -t code-index "done: ${NAME}"
        rm -f "$LOGTMP"
        return 0
    fi

    RC=$?
    logger -t code-index <"$LOGTMP"
    logger -t code-index "FAILED: ${NAME} ingest exit ${RC} - hash NOT updated, will retry next cron"
    rm -f "$LOGTMP"
    return 1
}

if [ $# -gt 0 ]; then
    # Explicit path: the historical single-repo behavior, unchanged.
    reindex_one "$(basename "$1")" "$1" repo ""
    exit $?
fi

# No-arg: every configured source. Written to a temp file rather than piped
# into the loop, so the loop body runs in THIS shell and a failure count
# actually survives it (a `... | while read` body is a subshell in POSIX sh).
LIST="$(mktemp -t code-index-sources)"
trap 'rm -f "$LIST"' EXIT

"$CODE_INDEX" sources --porcelain >"$LIST" 2>/dev/null || true

if [ ! -s "$LIST" ]; then
    logger -t code-index "no [[code_index.sources]] configured — nothing to reindex"
    exit 0
fi

FAILURES=0
while IFS="$(printf '\t')" read -r NAME ROOT KIND DB; do
    [ -n "$NAME" ] || continue
    # One bad source must not skip the others.
    reindex_one "$NAME" "$ROOT" "$KIND" "$DB" || FAILURES=$((FAILURES + 1))
done <"$LIST"

if [ "$FAILURES" -gt 0 ]; then
    logger -t code-index "reindex sweep: ${FAILURES} source(s) failed"
    exit 1
fi
