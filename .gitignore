/target/

# Core dumps (e.g. br.core from intermittent `br list --all` crashes, often
# in jail/pot runs — synced into the tree via the beads .sync machinery).
*.core

# local beads mirror — central beadsd is canonical
.beads/

# Python bytecode from the hook scripts (and from importing them in tests).
__pycache__/
*.pyc
